input ChannelInviteInput {
	channelKey: String!
	state: ChannelStateInput!
}

input ChannelMemberInput {
	peerId: ID!
	status: ChannelMemberStatus!
	name: String
	deviceType: DeviceType
	ip: String
	publicKey: String
	port: Int
}

enum ChannelMemberStatus {
	JOINED
	PENDING
}

input ChannelStateInput {
	name: String!
	version: Long!
	members: [ChannelMemberInput!]!
}

type ChatAttachment {
	id: ID!
	uri: String!
	size: Long!
	durationMs: Long!
	width: Int!
	height: Int!
	summary: String!
	fileName: String!
}

enum ChatAttachmentType {
	IMAGE
	FILE
}

union ChatContent = ChatMessageContent | ChatShareContent

type ChatDeliveryResult {
	peerId: ID!
	peerName: String!
	error: String
}

type ChatItem {
	"""
	`me` when this device created the item, otherwise the client id of
	the originating peer.
	"""
	fromId: ID!
	"""
	Peer id for direct messages; empty for channel messages —
	`channelId` is authoritative there.
	"""
	toId: ID!
	"""
	Null for direct messages: the store keeps "" and the contract says
	null, because "" is not a channel a client can query.
	"""
	channelId: ID
	id: ID!
	content: ChatContent!
	createdAt: Instant!
	updatedAt: Instant!
	status: ChatStatus!
	deliveryResults: [ChatDeliveryResult!]!
}

type ChatLinkPreview {
	url: String!
	title: String
	description: String
	image: String
	imageWidth: Int!
	imageHeight: Int!
	siteName: String
	domain: String
	createdAt: Instant!
}

type ChatMessageAttachment {
	type: ChatAttachmentType!
	attachment: ChatAttachment!
}

type ChatMessageContent {
	text: String
	format: ChatTextFormat!
	items: [ChatMessageAttachment!]!
	linkPreviews: [ChatLinkPreview!]!
}

type ChatShareContent {
	shareId: ID!
	urlToken: String!
	peerInfo: ChatSharePeer!
	name: String!
	itemCount: Long!
	totalSize: Long!
	expiresAt: Instant
}

type ChatSharePeer {
	id: ID!
	ip: String!
	port: Int!
}

enum ChatStatus {
	SENT
	FAILED
	PARTIAL
	PENDING
}

enum ChatTextFormat {
	PLAIN
	MARKDOWN
}

enum DeviceType {
	PHONE
	TABLET
	COMPUTER
	TV
	NAS
	OTHER
}

scalar Instant

scalar Long

type Mutation {
	createChatItem(content: String!): [ChatItem!]!
	notifyChannelInvite(channelId: ID!, input: ChannelInviteInput!): Boolean!
	notifyChannelStateChanged(channelId: ID!, input: ChannelStateInput!): Boolean!
	notifyChannelMemberRemoved(channelId: ID!, removedPeerId: ID!, version: Long!): Boolean!
	notifyChannelDeleted(channelId: ID!, version: Long!): Boolean!
	notifyChannelInviteResponse(channelId: ID!, accept: Boolean!): Boolean!
	notifyChannelMemberLeft(channelId: ID!): Boolean!
}

enum PeerStatus {
	PAIRED
	UNPAIRED
	CHANNEL
}

type Query {
}

"""
Directs the executor to include this field or fragment only when the `if` argument is true.
"""
directive @include(if: Boolean!) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT
"""
Directs the executor to skip this field or fragment when the `if` argument is true.
"""
directive @skip(if: Boolean!) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT
schema {
	query: Query
	mutation: Mutation
}
