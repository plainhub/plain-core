type Share {
	id: ID!
	name: String!
	password: String!
	expiresAt: Instant
	readOnly: Boolean!
	data: [SharePath!]!
	url: String!
}

input ShareInput {
	name: String!
	password: String!
	expiresAt: Instant
	readOnly: Boolean!
	data: [SharePathInput!]!
}

type SharePath {
	virtualPath: String!
	realPath: String!
	isDir: Boolean!
}

input SharePathInput {
	virtualPath: String!
	realPath: String!
	isDir: Boolean!
}

extend type Mutation {
	createShare(input: ShareInput!): Share!
	deleteShare(id: ID!): Boolean!
	updateShare(id: ID!, input: ShareInput!): Share!
}

extend type Query {
	share(id: ID!): Share
	shares: [Share!]!
}
