enum AccessFeature {
	IMAGES
	VIDEOS
	AUDIO
	DOCS
	FILES
	CONTACTS
	SMS
	CALL_LOGS
	CALL_PHONE
	PHONE_NUMBER
	APPS
	NOTIFICATIONS
	CLIPBOARD
	ADB
}

type AndroidExtras {
	sdkVersion: Int!
	versionCodeName: String!
	securityPatch: String!
	bootloader: String!
	fingerprint: String!
	hardware: String!
	radioVersion: String!
	board: String!
	buildBrand: String!
	buildNumber: String!
	device: String!
	javaVmVersion: String!
	glEsVersion: String!
	buildTime: Instant!
}

type App {
	clientId: String!
	httpPort: Int!
	httpsPort: Int!
	deviceName: String!
	developerMode: Boolean!
	urlToken: String!
	tlsCertificateSha256: String
	appDir: String!
	deviceType: DeviceType!
	capabilities: [Capability!]!
	buildChannel: AppChannelType!
	access: [AccessFeature!]!
	downloadsDir: String!
	debug: Boolean!
}

enum AppChannelType {
	GITHUB
	GOOGLE
	FDROID
}

enum Capability {
	ADB
	DIRECTORY_ACCESS
	BLE
	WIFI_AWARE
	BACKGROUND_SERVICE
	LAUNCHER_SHORTCUTS
	SOUND_METER
	BACKGROUND_TIMER
	BACKGROUND_WAKE
	FILE_EXPORT
	FILE_REVEAL
	FILE_CLIPBOARD
	APP_RELAUNCH
	MEDIA_TRASH
	MEDIA_DELETE
	MEDIA_MOVE
	MEDIA_FAVORITE
	VIDEO_REMUX
	VIDEO_TRANSCODE
	APP_UPDATES
	MIRROR_AUDIO
	DOC_PREVIEW
	IMAGE_SEARCH
	MEDIA_SCAN
	TELEPHONY
	PACKAGES
	SCREEN_MIRROR
	IMAGE_EDITOR
	NOTIFICATIONS
	CLIPBOARD
	LAN_SHARE
	DISK_MANAGER
}

type DeviceInfo {
	name: String!
	platform: DevicePlatform!
	manufacturer: String!
	model: String!
	osName: String!
	osVersion: String!
	kernelVersion: String!
	appVersion: String!
	appBuildNumber: String!
	language: String!
	cpuArch: String!
	cpuModel: String
	totalMemory: Long!
	totalStorage: Long!
	display: DisplayInfo
	android: AndroidExtras
}

enum DevicePlatform {
	ANDROID
	IOS
	MACOS
	WINDOWS
	LINUX
}

type DeviceStatus {
	uptimeSec: Long!
	batteryLevel: Int
	charging: Boolean!
	temperatures: [Temperature!]!
	cpuUsage: Float!
	memoryAvailable: Long
	storageAvailable: Long!
}

type DisplayInfo {
	width: Int!
	height: Int!
	density: Float!
}

"""
The `app` root echoes a write back rather than reading the store again,
so a caller can confirm what it asked for without a round trip.
"""
type KeyValuePair {
	key: String!
	value: String!
}

type Session {
	clientId: String!
	clientName: String!
	type: String!
	token: String!
	urlToken: String!
	clientIp: String!
	osName: String!
	osVersion: String!
	browserName: String!
	browserVersion: String!
	lastSeenAt: Instant
	lastActive: Instant!
	createdAt: Instant!
	updatedAt: Instant!
}

type Temperature {
	label: String!
	celsius: Float!
}

extend type Mutation {
	clearAppLogs: Boolean!
	exportAppLogs: String
	logout: Boolean!
	"""
	The app restarts itself; the response only acknowledges that the
	request was accepted, since the connection dies with the process.
	"""
	relaunchApp: Boolean!
	renameSession(clientId: String!, name: String!): Boolean!
	requestAccess(feature: AccessFeature!): Boolean!
	revokeSession(clientId: String!): Boolean!
	setTempValue(key: String!, value: String!): KeyValuePair!
	startDiscovery: Boolean!
	stopDiscovery: Boolean!
	"""
	Renaming the device also re-publishes the mDNS advertisement, so a
	client that waits for the new name to appear does see it.
	"""
	updateDeviceName(name: String!): Boolean!
}

extend type Query {
	"""
	Everything a client needs to reach this device: its identity, the
	port it listens on and the token that authorises it.
	"""
	app: App!
	appLogFilesSize: Long!
	appLogPath: String!
	"""
	Log lines, newest first. A blank `query` pages the buffer directly;
	a non-blank one filters the whole buffer and then pages, so a
	search cannot be cut short by the page size.
	"""
	appLogs(query: String!, offset: Int!, limit: Int!): [String!]!
	deviceInfo: DeviceInfo!
	deviceStatus: DeviceStatus!
	"""
	Whether the mDNS advertiser is currently scanning. Starting and
	stopping are commands, not state, so they report success rather
	than a snapshot the caller would have to re-read.
	"""
	isDiscovering: Boolean!
	sessions: [Session!]!
}
