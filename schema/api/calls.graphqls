type Call {
	typeCode: Int!
	id: ID!
	number: String!
	name: String!
	photo: String!
	startedAt: Instant!
	durationSec: Int!
	type: CallType!
	accountId: ID!
	geo: PhoneGeo
	tags: [Tag!]!
}

enum CallType {
	INCOMING
	OUTGOING
	MISSED
	VOICEMAIL
	REJECTED
	BLOCKED
	ANSWERED_EXTERNALLY
	UNKNOWN
}

type PhoneGeo {
	country: String!
	numberType: String!
	carrier: String!
	description: String!
}

extend type Mutation {
	"""
	`showDialer` hands the number to the dialer instead of placing the
	call outright.
	"""
	call(number: String!, showDialer: Boolean!): Boolean!
	deleteCalls(query: String!): ActionResult!
}

extend type Query {
	callCount(query: String!): Int!
	calls(query: String!, offset: Int!, limit: Int!): [Call!]!
}
