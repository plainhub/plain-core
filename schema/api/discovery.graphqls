type MdnsActivity {
	time: Long!
	event: String!
	detail: String!
}

type MdnsPacket {
	time: Long!
	direction: String!
	srcIp: String!
	srcPort: Int!
	dstIp: String!
	dstPort: Int!
	size: Long!
	summary: String!
	detail: String!
}

type MdnsService {
	serviceType: String!
	instanceName: String!
	instanceFqdn: String!
	hostname: String!
	port: Int!
	txtRecords: [String!]!
	ips: [String!]!
	ipv6: [String!]!
	complete: Boolean!
}

type MdnsState {
	runtimeId: String!
	packetsIn: [MdnsPacket!]!
	packetsOut: [MdnsPacket!]!
	revision: Long!
	running: Boolean!
	scanning: Boolean!
	services: [MdnsService!]!
	activity: [MdnsActivity!]!
}

type NearbyDevice {
	id: ID!
	name: String!
	ips: [String!]!
	port: Int!
	deviceType: String!
	version: String!
	platform: String!
	lastSeen: String!
	discoveryMethods: [String!]!
	bestIp: String!
	status: String!
}

extend type Mutation {
	acquireDiscovery(token: ID!): Boolean!
	releaseDiscovery(token: ID!): Boolean!
}

extend type Query {
	mdnsState: MdnsState!
	nearbyDevices: [NearbyDevice!]!
	parsePairingCode(code: String!): NearbyDevice
}
