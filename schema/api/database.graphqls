enum DbColumnType {
	TEXT
	INTEGER
	REAL
	BLOB
	NUMERIC
	UNKNOWN
}

type DbTableColumn {
	name: String!
	dataType: DbColumnType!
	notNull: Boolean!
	defaultValue: String
	primaryKey: Boolean!
}

type DbTableInfo {
	idKey: String!
	createSql: String!
}

extend type Mutation {
	"""
	`row` is a JSON object of column values. A malformed one is reported
	as `false` rather than an error: this is a developer console, and the
	operator is the one who typed it.
	"""
	createDbTableRow(table: String!, row: String!): Boolean!
	deleteDbTableRows(table: String!, ids: [String!]!): Boolean!
}

extend type Query {
	dbPath: String!
	dbTableColumns(table: String!): [DbTableColumn!]!
	dbTableInfo(table: String!): DbTableInfo!
	dbTableRowCount(table: String!): Long!
	"""
	Rows come back as pre-rendered JSON strings, one per row — the
	column set differs per table, so there is no single row type to
	model.
	"""
	dbTableRows(table: String!, offset: Int!, limit: Int!): [String!]!
	dbTables: [String!]!
}
