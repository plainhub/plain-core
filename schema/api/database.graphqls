enum DbColumnType {
	TEXT
	INTEGER
	REAL
	BLOB
	NUMERIC
	UNKNOWN
}

type DbTable {
	name: String!
	createSql: String!
	columns: [DbTableColumn!]!
}

type DbTableColumn {
	name: String!
	dataType: DbColumnType!
	notNull: Boolean!
	defaultValue: String
	primaryKey: Boolean!
}

extend type Mutation {
	createDbTableRow(table: String!, row: JSON!): Boolean!
	deleteDbTableRows(table: String!, ids: [String!]!): Boolean!
}

extend type Query {
	dbPath: String!
	dbTableRowCount(table: String!): Long!
	dbTableRows(table: String!, offset: Int!, limit: Int!): [JSON!]!
	dbTables: [DbTable!]!
}
