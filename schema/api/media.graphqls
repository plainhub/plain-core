type FileIndexDefaults {
	excludedDirs: [String!]!
	excludedNames: [String!]!
	excludedPackages: [String!]!
	excludedUserLibraries: Boolean!
}

type FileIndexVolume {
	id: ID!
	path: String!
	isAvailable: Boolean!
	indexMode: IndexMode!
	includedDirs: [String!]!
	excludedDirs: [String!]!
}

enum IndexMode {
	UNCONFIGURED
	DISABLED
	ALLOWLIST
	BLOCKLIST
}

type MediaBucket {
	size: Long!
	id: ID!
	name: String!
	itemCount: Int!
	topItemPaths: [String!]!
}

interface MediaItem {
	id: ID!
	title: String!
	path: String!
	size: Long!
	bucketId: ID!
	createdAt: Instant!
	updatedAt: Instant!
}

type MediaPlayHistory {
	mediaId: ID!
	mediaType: MediaDataType!
	positionMs: Long!
	playCount: Long!
	playedAt: Instant!
	media: MediaItem!
}

type ScanProgress {
	indexed: Int!
	pending: Int
	total: Int
	state: ScanState!
	error: String
}

"""
Media-index scan lifecycle, shared by `scanProgress.state` and the
`media:scan:progress` WS payload (same values on both wires).
"""
enum ScanState {
	IDLE
	RUNNING
	PAUSED
	STOPPED
	FAILED
}

extend type Mutation {
	pauseMediaScan: Boolean!
	rebuildFileIndexVolume(id: ID!): Boolean!
	rebuildMediaIndex(root: String!): Boolean!
	recordMediaPlay(mediaId: ID!, type: MediaDataType!, positionMs: Long!): Boolean!
	resumeMediaScan: Boolean!
	saveMediaPlayProgress(mediaId: ID!, type: MediaDataType!, positionMs: Long!): Boolean!
	setFileIndexVolume(id: ID!, indexMode: IndexMode!, includedDirs: [String!]!, excludedDirs: [String!]!): Boolean!
	stopMediaScan: Boolean!
}

extend type Query {
	fileIndexDefaults: FileIndexDefaults!
	fileIndexVolumes: [FileIndexVolume!]!
	mediaBuckets(type: MediaDataType!): [MediaBucket!]!
	mediaPlayHistory(query: String!, offset: Int!, limit: Int!): [MediaPlayHistory!]!
	scanProgress: ScanProgress!
}
