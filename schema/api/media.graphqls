type FileIndexDefaults {
	excludedDirs: [String!]!
	excludedNames: [String!]!
	excludedPackages: [String!]!
	excludedUserLibraries: Boolean!
}

enum FileIndexMode {
	UNCONFIGURED
	DISABLED
	ALLOWLIST
	BLOCKLIST
}

type FileIndexScanProgress {
	indexed: Int!
	pending: Int
	total: Int
	state: FileIndexScanState!
	error: String
}

"""
File-index scan lifecycle shared by query and subscription progress.
"""
enum FileIndexScanState {
	IDLE
	RUNNING
	PAUSED
	STOPPED
	FAILED
}

type FileIndexVolume {
	id: ID!
	path: String!
	isAvailable: Boolean!
	indexMode: FileIndexMode!
	includedDirs: [String!]!
	excludedDirs: [String!]!
}

type MediaBucket {
	size: Long!
	id: ID!
	name: String!
	itemCount: Int!
	topItemPaths: [String!]!
}

interface MediaItem {
	id: ID!
	title: String!
	path: String!
	size: Long!
	bucketId: ID!
	createdAt: Instant!
	updatedAt: Instant!
}

type MediaPlayHistory {
	mediaId: ID!
	mediaType: PlaybackType!
	positionMs: Long!
	playCount: Long!
	playedAt: Instant!
	media: MediaItem!
}

enum PlaybackType {
	AUDIO
	VIDEO
}

extend type Mutation {
	pauseFileIndexScan: Boolean!
	rebuildFileIndex(volumeId: ID): Boolean!
	recordMediaPlay(mediaId: ID!, type: PlaybackType!, positionMs: Long!): Boolean!
	resumeFileIndexScan: Boolean!
	saveMediaPlayProgress(mediaId: ID!, type: PlaybackType!, positionMs: Long!): Boolean!
	setFileIndexVolume(id: ID!, indexMode: FileIndexMode!, includedDirs: [String!]!, excludedDirs: [String!]!): Boolean!
	stopFileIndexScan: Boolean!
}

extend type Query {
	fileIndexDefaults: FileIndexDefaults!
	fileIndexVolumes: [FileIndexVolume!]!
	mediaBuckets(type: MediaDataType!): [MediaBucket!]!
	mediaPlayHistory(query: String!, offset: Int!, limit: Int!): [MediaPlayHistory!]!
	fileIndexScanProgress: FileIndexScanProgress!
}
