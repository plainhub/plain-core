type FileIndexDefaults {
	excludedDirs: [String!]!
	excludedNames: [String!]!
	"""
	Directory rules relative to every direct child of profilesDir.
	"""
	excludedProfileDirs: [FileIndexProfileDir!]!
	"""
	Case-insensitive directory suffixes excluded from media recognition only.
	"""
	mediaExcludedDirSuffixes: [String!]!
}

enum FileIndexMode {
	UNCONFIGURED
	DISABLED
	ALLOWLIST
	BLOCKLIST
}

type FileIndexProfileDir {
	"""
	Absolute parent directory ending in a slash; rules apply to every direct child profile.
	"""
	profilesDir: String!
	"""
	Excluded directory relative to each profile.
	"""
	excludedDir: String!
	"""
	Profile-relative exceptions; their ancestors remain traversable and other rules still apply.
	"""
	exceptDirs: [String!]!
}

type FileIndexScanProgress {
	volumeId: ID
	indexed: Int!
	pending: Int
	total: Int
	state: FileIndexScanState!
	error: String
}

"""
File-index scan lifecycle shared by query and subscription progress.
"""
enum FileIndexScanState {
	IDLE
	QUEUED
	RUNNING
	PAUSED
	STOPPED
	FAILED
}

enum FileIndexScanStatus {
	COMPLETED
	CANCELED
	FAILED
}

type FileIndexVolume {
	id: ID!
	path: String!
	isAvailable: Boolean!
	indexMode: FileIndexMode!
	includedDirs: [String!]!
	excludedDirs: [String!]!
	lastScanAt: Instant
	lastScanStatus: FileIndexScanStatus
	lastScanCount: Long
	lastScanTotal: Long
}

input FileIndexVolumeInput {
	indexMode: FileIndexMode!
	includedDirs: [String!]!
	excludedDirs: [String!]!
}

type MediaBucket {
	size: Long!
	id: ID!
	name: String!
	itemCount: Int!
	coverItems: [MediaBucketCover!]!
}

type MediaBucketCover {
	path: String!
	updatedAt: Instant!
	thumbHash: String
}

interface MediaItem {
	id: ID!
	title: String!
	path: String!
	size: Long!
	bucketId: ID!
	createdAt: Instant!
	updatedAt: Instant!
}

type MediaPlayHistory {
	mediaId: ID!
	mediaType: PlaybackType!
	positionMs: Long!
	playCount: Long!
	playedAt: Instant!
	media: MediaItem!
}

enum PlaybackType {
	AUDIO
	VIDEO
}

extend type Mutation {
	pauseFileIndex(volumeId: ID): Boolean!
	rebuildFileIndex(volumeId: ID): Boolean!
	recordMediaPlay(mediaId: ID!, type: PlaybackType!, positionMs: Long!): Boolean!
	resumeFileIndex(volumeId: ID): Boolean!
	saveMediaPlayProgress(mediaId: ID!, type: PlaybackType!, positionMs: Long!): Boolean!
	setFileIndexVolume(volumeId: ID!, input: FileIndexVolumeInput!): Boolean!
	stopFileIndex(volumeId: ID): Boolean!
}

extend type Query {
	fileIndexDefaults: FileIndexDefaults!
	fileIndexScanProgress(volumeId: ID): FileIndexScanProgress!
	fileIndexVolumes: [FileIndexVolume!]!
	mediaBuckets(type: MediaDataType!): [MediaBucket!]!
	mediaPlayHistory(query: String!, offset: Int!, limit: Int!): [MediaPlayHistory!]!
}
