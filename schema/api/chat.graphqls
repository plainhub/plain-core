type ChatAttachment {
	id: ID!
	uri: String!
	size: Long!
	durationMs: Long!
	width: Int!
	height: Int!
	summary: String!
	fileName: String!
}

input ChatAttachmentInput {
	id: ID!
	uri: String!
	size: Long!
	durationMs: Long! = 0
	width: Int! = 0
	height: Int! = 0
	summary: String! = ""
	fileName: String! = ""
}

union ChatContent = ChatTextContent | ChatImagesContent | ChatFilesContent | ChatShareContent

input ChatContentInput @oneOf {
	text: ChatTextInput
	images: ChatImagesInput
	files: ChatFilesInput
	share: ChatShareInput
}

type ChatConversation {
	id: ID!
	chat: ChatItem!
}

type ChatDeliveryResult {
	peerId: ID!
	peerName: String!
	error: String
}

type ChatFilesContent {
	items: [ChatAttachment!]!
}

input ChatFilesInput {
	items: [ChatAttachmentInput!]!
}

type ChatImagesContent {
	items: [ChatAttachment!]!
}

input ChatImagesInput {
	items: [ChatAttachmentInput!]!
}

type ChatItem {
	"""
	`me` when this device created the item, otherwise the client id of
	the originating peer.
	"""
	fromId: ID!
	"""
	Peer id for direct messages; empty for channel messages —
	`channelId` is authoritative there.
	"""
	toId: ID!
	"""
	Null for direct messages: the store keeps "" and the contract says
	null, because "" is not a channel a client can query.
	"""
	channelId: ID
	id: ID!
	content: ChatContent!
	createdAt: Instant!
	updatedAt: Instant!
	status: ChatStatus!
	deliveryResults: [ChatDeliveryResult!]!
}

type ChatLinkPreview {
	url: String!
	title: String
	description: String
	imageUrl: String
	imageLocalPath: String
	imageWidth: Int!
	imageHeight: Int!
	siteName: String
	domain: String
	createdAt: Instant!
}

input ChatLinkPreviewInput {
	url: String!
	title: String
	description: String
	imageUrl: String
	imageLocalPath: String
	imageWidth: Int! = 0
	imageHeight: Int! = 0
	siteName: String
	domain: String
	createdAt: Instant!
}

type ChatShareContent {
	shareId: ID!
	urlToken: String!
	peerInfo: ChatSharePeer!
	name: String!
	itemCount: Long!
	totalSize: Long!
	expiresAt: Instant
}

input ChatShareInput {
	shareId: ID!
	urlToken: String!
	peerInfo: ChatSharePeerInput!
	name: String!
	itemCount: Long! = 0
	totalSize: Long! = 0
	expiresAt: Instant
}

type ChatSharePeer {
	id: ID!
	ip: String!
	port: Int!
}

input ChatSharePeerInput {
	id: ID!
	ip: String!
	port: Int!
}

enum ChatStatus {
	SENT
	FAILED
	PARTIAL
	PENDING
}

type ChatTextContent {
	text: String!
	linkPreviews: [ChatLinkPreview!]!
}

type ChatTextEdit {
	changed: Boolean!
	chat: ChatItem!
}

input ChatTextInput {
	text: String!
	linkPreviews: [ChatLinkPreviewInput!]! = []
}

extend type Mutation {
	"""
	Always true: an id that is already gone is the state the caller asked
	for, and the contract has no way to say "nothing was there".
	"""
	deleteChatItem(id: ID!): Boolean!
	deleteChatItems(query: String!): ActionResult!
	editChatText(id: ID!, text: String!): ChatTextEdit!
	forwardChatItems(id: ID!, targets: [String!]!): [ChatItem!]!
	retryChatItem(id: ID!, recipientIds: [ID!]): ChatItem!
	sendChatItems(targets: [String!]!, content: ChatContentInput!): [ChatItem!]!
	sendFolderShare(targets: [String!]!, path: String!, name: String!, expiresAt: Instant): [ChatItem!]!
	sendShare(targets: [String!]!, shareId: ID!): [ChatItem!]!
}

extend type Query {
	chatConversations: [ChatConversation!]!
	chatCount(query: String!): Int!
	chatItem(id: ID!): ChatItem
	"""
	Messages in chronological order; `target`: `peer:<id>` or `channel:<id>`.
	"""
	chatItems(target: String!, query: String!, offset: Int!, limit: Int!): [ChatItem!]!
	chatRecords(query: String!, offset: Int!, limit: Int!): [ChatItem!]!
}
