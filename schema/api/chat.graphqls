enum ChannelMemberStatus {
	JOINED
	PENDING
}

type ChatChannel {
	actions: ChatChannelActions!
	id: ID!
	ownerId: ID!
	name: String!
	members: [ChatChannelMember!]!
	"""
	Monotonically increasing mutation counter; receivers ignore channel
	updates whose version is not greater than their local copy.
	"""
	version: Long!
	status: ChatChannelStatus!
	createdAt: Instant!
	updatedAt: Instant!
	key: String!
}

type ChatChannelActions {
	isOwner: Boolean!
	canRename: Boolean!
	canManageMembers: Boolean!
	canLeave: Boolean!
	canDelete: Boolean!
}

type ChatChannelMember {
	peerId: ID!
	status: ChannelMemberStatus!
}

enum ChatChannelStatus {
	JOINED
	LEFT
	KICKED
}

type ChatConversation {
	id: ID!
	chat: ChatItem!
}

type ChatItem {
	"""
	`me` when this device created the item, otherwise the client id of
	the originating peer.
	"""
	fromId: ID!
	"""
	Peer id for direct messages; empty for channel messages —
	`channelId` is authoritative there.
	"""
	toId: ID!
	"""
	Null for direct messages: the store keeps "" and the contract says
	null, because "" is not a channel a client can query.
	"""
	channelId: ID
	id: ID!
	"""
	Message envelope JSON: `{type: TEXT|IMAGES|FILES|SHARE, value: {…}}` —
	parse `value` according to `type`.
	"""
	content: String!
	createdAt: Instant!
	updatedAt: Instant!
	status: ChatStatus!
	"""
	Per-recipient delivery details as JSON (peer delivery results);
	empty when the message has no delivery failures. Drives
	SENT/PARTIAL/FAILED alongside `status`.
	"""
	statusData: String!
}

enum ChatStatus {
	SENT
	FAILED
	PARTIAL
	PENDING
}

type ChatTextEdit {
	changed: Boolean!
	chat: ChatItem!
}

extend type Mutation {
	acceptChatChannelInvite(id: ID!): Boolean!
	addChatChannelMember(id: ID!, peerId: ID!): ChatChannel!
	createChatChannel(name: String!): ChatChannel!
	declineChatChannelInvite(id: ID!): Boolean!
	deleteChatChannel(id: ID!): Boolean!
	"""
	Always true: an id that is already gone is the state the caller asked
	for, and the contract has no way to say "nothing was there".
	"""
	deleteChatItem(id: ID!): Boolean!
	deleteChatItems(query: String!): ActionResult!
	deliverChatItem(id: ID!, recipients: [ID!]): ChatItem!
	editChatText(id: ID!, text: String!): ChatTextEdit!
	forwardChatItems(id: ID!, targets: [String!]!): [ChatItem!]!
	leaveChatChannel(id: ID!): Boolean!
	removeChatChannelMember(id: ID!, peerId: ID!): ChatChannel!
	retryChatItem(id: ID!): ChatItem!
	"""
	Send to `peer:<id>` or `channel:<id>`; `content` uses the `ChatItem.content` JSON envelope.
	"""
	sendChatItem(target: String!, content: String!): [ChatItem!]!
	sendChatItems(targets: [String!]!, content: String!): [ChatItem!]!
	sendFolderShare(targets: [String!]!, path: String!, name: String!, expiresAt: Instant): [ChatItem!]!
	sendShare(targets: [String!]!, shareId: ID!): [ChatItem!]!
	updateChatChannel(id: ID!, name: String!): ChatChannel!
}

extend type Query {
	chatChannels: [ChatChannel!]!
	chatConversations: [ChatConversation!]!
	chatCount(query: String!): Int!
	chatItem(id: ID!): ChatItem
	"""
	Messages in chronological order; `target`: `peer:<id>` or `channel:<id>`.
	"""
	chatItems(target: String!, query: String!, offset: Int!, limit: Int!): [ChatItem!]!
	chatRecords(query: String!, offset: Int!, limit: Int!): [ChatItem!]!
}
