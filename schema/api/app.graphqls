type AppUpdate {
	currentVersion: String!
	latestVersion: String
	releaseName: String!
	publishedAt: Instant
	hasUpdate: Boolean!
	url: String
}

type Disk {
	id: ID!
	name: String!
	path: String!
	sizeBytes: Long!
	removable: Boolean!
	model: String
}

type Event {
	id: ID!
	type: EventType!
	message: String!
	clientId: String
	createdAt: Instant!
}

enum EventType {
	LOGIN
	LOGIN_FAILED
	LOGOUT
	REVOKE
	SET_HOSTNAME
	UPDATE_DEVICE_NAME
	MOUNT
	MOUNT_FAILED
	UNMOUNT
	FORMAT_DISK
	FORMAT_DISK_FAILED
}

type Mutation {
	clearAppCache: Boolean!
	formatDisk(path: String!): Boolean!
	setHostname(name: String!): Boolean!
	setMountAlias(id: ID!, alias: String!): Boolean!
}

type Query {
	appCacheSize: Long!
	appUpdate: AppUpdate!
	disks: [Disk!]!
	events(query: String!, offset: Int!, limit: Int!): [Event!]!
}
