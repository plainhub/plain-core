type AppUpdate {
	currentVersion: String!
	latestVersion: String
	releaseName: String!
	publishedAt: Instant
	hasUpdate: Boolean!
	url: String
}

type DeviceNameEventData {
	oldName: String!
	newName: String!
}

type Disk {
	id: ID!
	name: String!
	path: String!
	sizeBytes: Long!
	removable: Boolean!
	model: String
}

type DiskFormatEventData {
	disk: EventDisk!
	fileSystem: String!
}

type DiskFormatFailedEventData {
	disk: EventDisk!
	fileSystem: String!
	failure: EventFailure!
}

enum ErrorCode {
	EVENT_STORAGE_FAILED
	UNSUPPORTED_CAPABILITY
	SLOW_CLIENT
	ACTION_NOT_FOUND
	BULK_QUERY_REQUIRED
	CANCELED
	CHAT_PAIRING_UNAVAILABLE
	CLIPBOARD_SYNC_DISABLED
	CONNECTION_TIMEOUT
	FAILED
	FAILED_CONNECT
	FAILED_CONNECT_WS
	FEED_NOT_FOUND
	FORBIDDEN
	INTERNAL_ERROR
	INVALID_AUTH_RESPONSE
	INVALID_CLIPBOARD_TEXT
	INVALID_FEED_URL
	INVALID_IDENTITY
	INVALID_KEY_VALUE
	INVALID_LOGIN_IDENTITY
	INVALID_LOGIN_KEY
	INVALID_LOGIN_REQUEST
	INVALID_PASSWORD
	INVALID_PREF_VALUE
	INVALID_SESSION
	INVALID_SUBSCRIPTION
	LOGIN_EXPIRED
	MANAGED_SOCKET_CLOSED
	MANAGED_SUBSCRIPTION_CLOSED
	NO_PERMISSION
	PASSWORD_REQUIRED
	PASSWORD_SETUP_REQUIRED
	PEER_IDENTITY_CHANGED
	PEER_REMOVED
	PROXY_AUTH_FAILED
	REJECTED
	REMOTE_ACCESS_DISABLED
	SECURE_LOGIN_UNAVAILABLE
	SIGNATURE_VERIFICATION_FAILED
	SUBSCRIPTION_RESULT_TOO_LARGE
	TIMEOUT
	TOO_MANY_LOGIN_ATTEMPTS
	TOO_MANY_LOGIN_CONNECTIONS
	UNAUTHORIZED
	MOUNT_FAILED
	FORMAT_DISK_FAILED
	PAIRING_TRANSPORT_UNAVAILABLE
	PAIRING_ADDRESS_UNAVAILABLE
	REQUEST_CONTEXT_CHANGED
	PEER_HTTPS_UNAVAILABLE
	PEER_ADDRESS_UNAVAILABLE
	ARCHIVE_ENTRY_UNAVAILABLE
	PREFERENCE_UPDATE_FAILED
	BLE_CONNECTION_CLOSING
	BLE_PAIRING_CAPACITY_EXCEEDED
	RESYNC_REQUIRED
	NETWORK_ERROR
	NATIVE_ERROR
	NATIVE_PEER_ID_MISSING
	INVALID_REQUEST
}

type Event {
	id: ID!
	type: EventType!
	data: EventData!
	clientId: ID
	clientName: String
	clientIp: String
	osName: String
	osVersion: String
	appName: String
	appVersion: String
	createdAt: Instant!
}

union EventData = LoginEventData | LoginFailedEventData | SessionEventData | DeviceNameEventData | VolumeEventData | VolumeFailedEventData | DiskFormatEventData | DiskFormatFailedEventData

type EventDisk {
	id: String
	name: String
	path: String!
	sizeBytes: Long
}

type EventFailure {
	reason: ErrorCode!
	detail: String
}

type EventSession {
	clientId: String!
	clientName: String!
	type: SessionType!
}

enum EventType {
	LOGIN
	LOGIN_FAILED
	LOGOUT
	REVOKE_SESSION
	UPDATE_DEVICE_NAME
	MOUNT
	MOUNT_FAILED
	UNMOUNT
	FORMAT_DISK
	FORMAT_DISK_FAILED
}

type EventVolume {
	id: String
	name: String
	devicePath: String
	mountPath: String!
	fileSystem: String
}

type HttpServer {
	state: HttpServerState!
	addresses: [String!]!
	onlineClients: [ID!]!
	remoteAccess: Boolean!
	mdnsHostname: String!
}

type HttpServerState {
	revision: Long!
	restarting: Boolean!
	httpPort: Int!
	httpsPort: Int!
	error: String!
}

type LoginEventData {
	sessionType: SessionType!
}

type LoginFailedEventData {
	reason: ErrorCode!
}

type SessionEventData {
	session: EventSession!
}

type VolumeEventData {
	volume: EventVolume!
}

type VolumeFailedEventData {
	volume: EventVolume!
	failure: EventFailure!
}

type Mutation {
	clearAppCache: Boolean!
	formatDisk(path: String!): Boolean!
	restartHttpServer(httpPort: Int, httpsPort: Int): HttpServerState!
	setMountAlias(id: ID!, alias: String!): Boolean!
}

type Query {
	appCacheSize: Long!
	appUpdate: AppUpdate!
	disks: [Disk!]!
	events(query: String!, offset: Int!, limit: Int!): [Event!]!
	httpServer: HttpServer!
}
