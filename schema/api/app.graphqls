type AppUpdate {
	currentVersion: String!
	latestVersion: String
	releaseName: String!
	publishedAt: Instant
	hasUpdate: Boolean!
	url: String
}

enum AuthErrorCode {
	CANCELED
	EVENT_STORAGE_FAILED
	INTERNAL_ERROR
	INVALID_AUTH_RESPONSE
	INVALID_IDENTITY
	INVALID_LOGIN_IDENTITY
	INVALID_LOGIN_KEY
	INVALID_LOGIN_REQUEST
	INVALID_PASSWORD
	LOGIN_EXPIRED
	PASSWORD_SETUP_REQUIRED
	PEER_IDENTITY_CHANGED
	REJECTED
	REMOTE_ACCESS_DISABLED
	TOO_MANY_LOGIN_ATTEMPTS
	TOO_MANY_LOGIN_CONNECTIONS
	TIMEOUT
	SECURE_LOGIN_UNAVAILABLE
	SIGNATURE_VERIFICATION_FAILED
	FAILED_CONNECT_WS
	PROXY_AUTH_FAILED
	FAILED
	UNAUTHORIZED
	CHAT_PAIRING_UNAVAILABLE
}

type DeviceNameEventData {
	oldName: String!
	newName: String!
}

type Disk {
	id: ID!
	name: String!
	path: String!
	sizeBytes: Long!
	removable: Boolean!
	model: String
}

enum DiskFormatErrorCode {
	FORMAT_DISK_FAILED
}

type DiskFormatEventData {
	disk: EventDisk!
	fileSystem: String!
}

type DiskFormatFailedEventData {
	disk: EventDisk!
	fileSystem: String!
	failure: DiskFormatFailure!
}

type DiskFormatFailure {
	reason: DiskFormatErrorCode!
	detail: String
}

type Event {
	id: ID!
	type: EventType!
	data: EventData!
	clientId: ID
	clientName: String
	clientIp: String
	osName: String
	osVersion: String
	appName: String
	appVersion: String
	createdAt: Instant!
}

union EventData = LoginEventData | LoginFailedEventData | SessionEventData | DeviceNameEventData | VolumeEventData | VolumeFailedEventData | DiskFormatEventData | DiskFormatFailedEventData

type EventDisk {
	id: String
	name: String
	path: String!
	sizeBytes: Long
}

type EventSession {
	clientId: String!
	clientName: String!
	type: SessionType!
}

enum EventType {
	LOGIN
	LOGIN_FAILED
	LOGOUT
	REVOKE_SESSION
	UPDATE_DEVICE_NAME
	MOUNT
	MOUNT_FAILED
	UNMOUNT
	FORMAT_DISK
	FORMAT_DISK_FAILED
}

type EventVolume {
	id: String
	name: String
	devicePath: String
	mountPath: String!
	fileSystem: String
}

type HttpServer {
	state: HttpServerState!
	addresses: [String!]!
	onlineClients: [ID!]!
	remoteAccess: Boolean!
	mdnsHostname: String!
}

type HttpServerState {
	revision: Long!
	restarting: Boolean!
	httpPort: Int!
	httpsPort: Int!
	error: String!
}

type LoginEventData {
	sessionType: SessionType!
}

type LoginFailedEventData {
	reason: AuthErrorCode!
}

enum MountErrorCode {
	MOUNT_FAILED
}

type MountFailure {
	reason: MountErrorCode!
	detail: String
}

type SessionEventData {
	session: EventSession!
}

type VolumeEventData {
	volume: EventVolume!
}

type VolumeFailedEventData {
	volume: EventVolume!
	failure: MountFailure!
}

type Mutation {
	clearAppCache: Boolean!
	formatDisk(path: String!): Boolean!
	restartHttpServer(httpPort: Int, httpsPort: Int): HttpServerState!
	setMountAlias(id: ID!, alias: String!): Boolean!
}

type Query {
	appCacheSize: Long!
	appUpdate: AppUpdate!
	disks: [Disk!]!
	events(query: String!, offset: Int!, limit: Int!): [Event!]!
	httpServer: HttpServer!
}
