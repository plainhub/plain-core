type AppUpdate {
	currentVersion: String!
	latestVersion: String
	releaseName: String!
	publishedAt: Instant
	hasUpdate: Boolean!
	url: String
}

type AuditEvent {
	id: ID!
	type: AuditEventType!
	message: String!
	clientId: String
	createdAt: Instant!
}

enum AuditEventType {
	LOGIN
	LOGIN_FAILED
	LOGOUT
	REVOKE
	SET_HOSTNAME
	UPDATE_DEVICE_NAME
	MOUNT
	MOUNT_FAILED
	UNMOUNT
	FORMAT_DISK
	FORMAT_DISK_FAILED
}

type Disk {
	id: ID!
	name: String!
	path: String!
	sizeBytes: Long!
	removable: Boolean!
	model: String
}

type Mutation {
	clearAppCache: Boolean!
	formatDisk(path: String!): Boolean!
	setHostname(name: String!): Boolean!
	setMountAlias(id: ID!, alias: String!): Boolean!
}

type Query {
	appCacheSize: Long!
	appUpdate: AppUpdate!
	auditEvents(query: String!, offset: Int!, limit: Int!): [AuditEvent!]!
	disks: [Disk!]!
}
