type Sim {
	id: ID!
	label: String!
	number: String!
	subscriptionId: Int!
}

type Sms {
	id: ID!
	body: String!
	address: String!
	sentAt: Instant!
	serviceCenter: String!
	read: Boolean!
	threadId: ID!
	type: SmsType!
	typeCode: Int!
	subscriptionId: Int!
	isMms: Boolean!
	attachments: [SmsAttachment!]!
	tags: [Tag!]!
}

type SmsAttachment {
	path: String!
	contentType: String!
	name: String!
}

type SmsConversation {
	id: ID!
	address: String!
	snippet: String!
	lastMessageAt: Instant!
	messageCount: Int!
	read: Boolean!
	addresses: [String!]!
}

type SmsCounts {
	total: Int!
	inbox: Int!
	sent: Int!
	drafts: Int!
}

type SmsSendReceipt {
	requestId: String!
	requiresConfirmation: Boolean!
}

enum SmsType {
	INBOX
	SENT
	DRAFT
	OUTBOX
	FAILED
	QUEUED
	UNKNOWN
}

extend type Mutation {
	archiveSmsConversation(id: ID!, date: Instant): Boolean!
	deleteSms(query: String!): ActionResult!
	restoreSms(query: String!): ActionResult!
	sendSms(number: String!, body: String!, attachmentPaths: [String!]! = [], subscriptionId: Int, requestId: String!): SmsSendReceipt!
	trashSms(query: String!): ActionResult!
	unarchiveSmsConversation(id: ID!): Boolean!
}

extend type Query {
	archivedSmsConversations(query: String!, offset: Int!, limit: Int!): [SmsConversation!]!
	sims: [Sim!]!
	sms(query: String!, offset: Int!, limit: Int!): [Sms!]!
	smsBoxCounts: SmsCounts!
	smsConversationCount(query: String!): Int!
	smsConversations(query: String!, offset: Int!, limit: Int!): [SmsConversation!]!
	smsCount(query: String!): Int!
}
