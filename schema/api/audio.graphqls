type AudioAlbumCover {
	albumId: ID!
	trackCount: Int!
	candidatePaths: [String!]!
}

type AudioArtist {
	name: String!
	itemCount: Int!
	playCount: Long!
	samplePath: String!
}

type AudioItem {
	mediaId: ID
	title: String!
	artist: String!
	path: String!
	durationMs: Long!
}

type AudioPlayback {
	mediaId: ID
	path: String
}

type AudioPlaylist {
	id: ID!
	name: String!
	itemCount: Int!
	coverAlbums: [AudioAlbumCover!]!
	createdAt: Instant!
	updatedAt: Instant!
}

enum AudioSortBy {
	UPDATED_AT_ASC
	UPDATED_AT_DESC
	SIZE_ASC
	SIZE_DESC
	TITLE_ASC
	TITLE_DESC
}

enum MediaPlayMode {
	REPEAT
	REPEAT_ONE
	SHUFFLE
}

extend type Mutation {
	addAudioPlaylistItems(id: ID!, query: String!): Boolean!
	addAudioToQueue(query: String!): Boolean!
	clearAudioQueue: Boolean!
	createAudioPlaylist(name: String!): AudioPlaylist!
	deleteAudioPlaylist(id: ID!): Boolean!
	removeAudioFromQueue(mediaId: ID!): Boolean!
	removeAudioPlaylistItems(id: ID!, query: String!): ActionResult!
	reorderAudioQueue(mediaIds: [ID!]!): Boolean!
	replaceAudioQueue(query: String!, sortBy: AudioSortBy!, shuffle: Boolean!): AudioItem
	selectAudio(mediaId: ID!): AudioItem!
	selectAudioByPath(path: String!): AudioItem!
	updateAudioPlayMode(mode: MediaPlayMode!): Boolean!
	updateAudioPlaylist(id: ID!, name: String!): AudioPlaylist!
}

extend type Query {
	audioArtists: [AudioArtist!]!
	audioByPath(path: String!): AudioItem!
	audioCount(query: String!): Int!
	audioLyrics(mediaId: ID!): String
	audioLyricsByPath(path: String!): String
	audioPlayback: AudioPlayback!
	audioPlaylist(id: ID!): AudioPlaylist
	audioPlaylistItemCount(id: ID!, query: String!): Int!
	audioPlaylistItems(id: ID!, query: String!, offset: Int!, limit: Int!): [AudioItem!]!
	audioPlaylists: [AudioPlaylist!]!
	audioQueueItemCount(query: String!): Int!
	audioQueueItems(query: String!, offset: Int!, limit: Int!): [AudioItem!]!
	audios(query: String!, offset: Int!, limit: Int!, sortBy: AudioSortBy!): [Audio!]!
}
