input PairPeerInput {
	peerId: ID!
	mode: PairingMode!
	password: String
}

enum PairingMode {
	CHAT
	MANAGE
}

type Peer {
	id: ID!
	name: String!
	ip: String!
	status: PeerStatus!
	port: Int
	deviceType: DeviceType!
	createdAt: Instant!
	updatedAt: Instant!
	online: Boolean!
	managed: Boolean!
	key: String!
	publicKey: String!
	token: String!
}

extend type Mutation {
	cancelPairing(peerId: ID!): Boolean!
	deletePeer(peerId: ID!): Boolean!
	pairPeer(input: PairPeerInput!): Boolean!
	respondToPairing(peerId: ID!, accepted: Boolean!): Boolean!
	unpairPeer(peerId: ID!): Boolean!
}

extend type Query {
	peerFileUrl(peerId: ID!, fileId: String!): String!
	peers: [Peer!]!
}
