input PairingDeviceInput {
	id: ID
	host: String
	mode: PairingMode
	password: String
	generation: String
}

enum PairingMode {
	CHAT
	MANAGE
}

enum PairingPhase {
	STARTING
	PASSWORD_REQUIRED
	AUTHENTICATING
	PAIRING
	WAITING_CONFIRMATION
	COMMITTING
	SUCCEEDED
	FAILED
	CANCELLED
}

input PairingRequestInput {
	fromId: ID!
	fromName: String!
	port: Int!
	deviceType: DeviceType!
	ecdhPublicKey: String!
	signaturePublicKey: String!
	timestamp: Long!
	ips: [String!]!
	signature: String!
	fromIp: String!
	awareSupported: Boolean!
}

type PairingState {
	deviceId: ID
	generation: String!
	mode: PairingMode!
	phase: PairingPhase!
	error: String
	verificationCode: String
}

input PeerRecordInput {
	id: ID!
	name: String!
	ip: String!
	key: String!
	publicKey: String!
	status: PeerStatus!
	port: Int
	deviceType: DeviceType!
	token: String!
	createdAt: Instant!
	updatedAt: Instant!
}

type Sim {
	id: ID!
	label: String!
	number: String!
	subscriptionId: Int!
}

extend type Mutation {
	cancelPairing(generation: String!): Boolean!
	deletePeer(id: ID!): Boolean!
	pairDevice(input: PairingDeviceInput!): PairingState!
	respondToPairing(input: PairingRequestInput!, accepted: Boolean!): Boolean!
	unpairPeer(id: ID!): Boolean!
}

extend type Query {
	pairingStates: [PairingState!]!
	peerFileUrl(id: ID!, expected: PeerRecordInput!, fileId: String!): String!
	peers: [Peer!]!
	sims: [Sim!]!
}
