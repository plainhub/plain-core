type ActionResult {
	affectedCount: Int!
}

type Audio implements MediaItem {
	albumId: ID!
	id: ID!
	title: String!
	artist: String!
	path: String!
	durationMs: Long!
	size: Long!
	bucketId: ID!
	createdAt: Instant!
	updatedAt: Instant!
	isFavorite: Boolean!
	albumFileId: String!
	tags: [Tag!]!
}

type ChannelChange {
	changed: Boolean!
	invite: ChannelInvite
	cancel: ChannelInviteCancellation
}

type ChannelInvite {
	channelId: ID!
	channelName: String!
	ownerPeerId: ID!
	ownerPeerName: String!
}

type ChannelInviteCancellation {
	channelId: ID!
	ownerPeerId: ID!
}

type ClipboardChange {
	text: String!
	sensitive: Boolean!
	time: Instant!
}

enum DeviceType {
	COMPUTER
	PHONE
	TABLET
	TV
	NAS
	OTHER
}

type Doc implements MediaItem {
	durationMs: Long!
	id: ID!
	title: String!
	path: String!
	extension: String!
	size: Long!
	bucketId: ID!
	createdAt: Instant!
	updatedAt: Instant!
	tags: [Tag!]!
}

type FeedSyncChange {
	feedId: ID!
	error: String
	cancelled: Boolean
}

type FileSearchResults {
	items: [File!]!
	offset: Long!
	count: Long!
	complete: Boolean!
}

enum FileSortBy {
	DATE_ASC
	DATE_DESC
	SIZE_ASC
	SIZE_DESC
	NAME_ASC
	NAME_DESC
	TAKEN_AT_DESC
}

type Image implements MediaItem {
	id: ID!
	title: String!
	path: String!
	size: Long!
	width: Int!
	height: Int!
	rotation: Int!
	bucketId: ID!
	createdAt: Instant!
	updatedAt: Instant!
	takenAt: Instant
	isFavorite: Boolean!
	tags: [Tag!]!
}

type ImageModelsUpdate {
	version: Long!
	status: ImageSearchStatusType!
	downloadProgress: Int!
	errorMessage: String!
	modelSize: Long!
	modelDir: String!
	isIndexing: Boolean!
	totalImages: Int!
	indexedImages: Int!
}

scalar Instant

"""
A scalar that can represent any JSON value.
"""
scalar JSON

type LibraryChange {
	types: [Int!]!
}

scalar Long

"""
Media-library item kinds accepted by media item actions and buckets
(plain-app `MediaDataType`).
"""
enum MediaDataType {
	AUDIO
	VIDEO
	IMAGE
	DOC
}

type MirrorCodecConfiguration {
	annexB: String!
}

type MirrorState {
	running: Boolean!
}

type MmsSendResult {
	pendingId: ID!
	success: Boolean!
	resultCode: Int
}

type PairingCompletedNotice {
	deviceId: ID!
	deviceName: String!
	ip: String!
	port: Int
	deviceType: DeviceType
	requestId: String
}

type PairingProgressNotice {
	verificationCode: String
	deviceId: ID!
	deviceName: String!
	error: String
}

type PairingRequestNotice {
	fromIp: String!
	fromId: ID!
	fromName: String!
	deviceType: DeviceType!
	verificationCode: String!
	identityChanged: Boolean!
}

type Peer {
	id: ID!
	name: String!
	ip: String!
	status: PeerStatus!
	port: Int
	deviceType: DeviceType!
	createdAt: Instant!
	updatedAt: Instant!
	online: Boolean!
	managed: Boolean!
	key: String!
	publicKey: String!
	token: String!
	address: PeerAddress
}

type PeerAddress {
	bestIp: String!
	baseUrl: String!
	apiUrl: String!
	statusWsUrl: String!
}

enum PeerStatus {
	PAIRED
	UNPAIRED
	CHANNEL
}

type PomodoroAction {
	today: PomodoroToday!
	completedState: PomodoroState
}

type SmsProviderChange {
	uris: [String!]!
}

type SmsSendResult {
	requestId: ID
	success: Boolean!
	resultCode: Int
}

type Subscription {
	prefsChanged: Boolean!
	peersChanged: Boolean!
	channelsChanged: ChannelChange!
	downloadsChanged: Boolean!
	imageModelsUpdated: ImageModelsUpdate!
	pairingRequested: PairingRequestNotice!
	pairingCompleted: PairingCompletedNotice!
	pairingStarted: PairingProgressNotice!
	pairingFailed: PairingProgressNotice!
	pairingCanceled: PairingProgressNotice!
	pomodoroSettingsChanged: Boolean!
	pomodoroAction: PomodoroAction!
	dlnaSenderChanged: DlnaSenderState!
	deviceNameUpdated: String!
	accessUpdated: Boolean!
	contentChanged: Boolean!
	clipboardChanged: ClipboardChange!
	screenMirrorState: MirrorState!
	screenMirrorVideoCodec: MirrorCodecConfiguration
	screenMirrorAudioGranted: Boolean!
	notificationCreated: Notification!
	notificationUpdated: Notification!
	notificationDeleted: Notification!
	notificationRefreshed: Boolean!
	messagesCreated: [ChatItem!]!
	messagesUpdated: [ChatItem!]!
	messagesDeleted: String!
	mediaLibraryUpdated: LibraryChange!
	mediaScanProgress: ScanProgress!
	bookmarksUpdated: [Bookmark!]!
	feedsFetched: FeedSyncChange!
	uploadMergeResult: UploadMergeResult!
	fileSearchResults(root: String!, query: String!, offset: Int!, limit: Int!, sortBy: FileSortBy!): FileSearchResults!
	smsProviderChanged: SmsProviderChange
	smsSendResult: SmsSendResult!
	mmsSendResult: MmsSendResult!
	mmsSent: String!
}

type Tag {
	id: ID!
	name: String!
	type: Int!
	count: Int!
}

type UploadMergeResult {
	fileId: ID!
	ok: Boolean!
	value: String
	mergedSize: Long
	error: String
}

type Video implements MediaItem {
	width: Int!
	height: Int!
	rotation: Int!
	id: ID!
	title: String!
	path: String!
	durationMs: Long!
	size: Long!
	bucketId: ID!
	createdAt: Instant!
	updatedAt: Instant!
	takenAt: Instant
	isFavorite: Boolean!
	tags: [Tag!]!
}

"""
Directs the executor to include this field or fragment only when the `if` argument is true.
"""
directive @include(if: Boolean!) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT

"""
Directs the executor to skip this field or fragment when the `if` argument is true.
"""
directive @skip(if: Boolean!) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT

schema {
	query: Query
	mutation: Mutation
	subscription: Subscription
}
