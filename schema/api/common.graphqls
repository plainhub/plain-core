type ActionResult {
	affectedCount: Int!
}

type Audio implements MediaItem {
	albumId: ID!
	id: ID!
	title: String!
	artist: String!
	path: String!
	durationMs: Long!
	size: Long!
	bucketId: ID!
	createdAt: Instant!
	updatedAt: Instant!
	isFavorite: Boolean!
	albumFileId: String!
	tags: [Tag!]!
}

type ClipboardChange {
	text: String!
	sensitive: Boolean!
	time: Instant!
}

"""
Taggable data domains — the plain-app `DataType` wire enum
(`shared/src/commonMain/kotlin/com/ismartcoding/plain/enums/DataType.kt`).
GraphQL-arg and tag-column domain; `kind()` is the ordinal stored in
the shared library db `type` column.
"""
enum DataType {
	DEFAULT
	AUDIO
	VIDEO
	IMAGE
	SMS
	CONTACT
	NOTE
	FEED_ENTRY
	CALL
	PACKAGE
	FILE
	APP_FILE
	DOC
}

enum DeviceType {
	COMPUTER
	PHONE
	TABLET
	TV
	NAS
	OTHER
}

type Doc implements MediaItem {
	id: ID!
	title: String!
	path: String!
	extension: String!
	size: Long!
	bucketId: ID!
	createdAt: Instant!
	updatedAt: Instant!
	tags: [Tag!]!
}

type FeedSyncChange {
	feedId: ID!
	error: String
	cancelled: Boolean
}

type FileSearchResults {
	items: [File!]!
	offset: Long!
	count: Long!
	complete: Boolean!
}

enum FileSortBy {
	DATE_ASC
	DATE_DESC
	SIZE_ASC
	SIZE_DESC
	NAME_ASC
	NAME_DESC
	TAKEN_AT_DESC
}

type Image implements MediaItem {
	id: ID!
	title: String!
	path: String!
	size: Long!
	width: Int!
	height: Int!
	rotation: Int!
	bucketId: ID!
	createdAt: Instant!
	updatedAt: Instant!
	takenAt: Instant
	isFavorite: Boolean!
	tags: [Tag!]!
}

type ImageModelsUpdate {
	version: Long!
	status: ImageSearchStatusType!
	downloadProgress: Int!
	errorMessage: String!
	modelSize: Long!
	modelDir: String!
	isIndexing: Boolean!
	totalImages: Int!
	indexedImages: Int!
}

scalar Instant

"""
A scalar that can represent any JSON value.
"""
scalar JSON

scalar Long

type MediaChange {
	types: [DataType!]!
}

"""
Media-library item kinds accepted by media item actions and buckets
(plain-app `MediaDataType`).
"""
enum MediaDataType {
	AUDIO
	VIDEO
	IMAGE
	DOC
}

type MirrorCodecConfiguration {
	annexB: String!
}

type MirrorState {
	running: Boolean!
}

type PairingCompletedNotice {
	deviceId: ID!
	deviceName: String!
	ip: String!
	port: Int
	deviceType: DeviceType
	requestId: String
}

type PairingProgressNotice {
	verificationCode: String
	deviceId: ID!
	deviceName: String!
	error: String
}

type PairingRequestNotice {
	fromIp: String!
	fromId: ID!
	fromName: String!
	deviceType: DeviceType!
	verificationCode: String!
	identityChanged: Boolean!
}

enum PeerStatus {
	PAIRED
	UNPAIRED
	CHANNEL
}

type PomodoroAction {
	today: PomodoroToday!
	completedState: PomodoroState
}

type SmsProviderChange {
	uris: [String!]!
}

type SmsSendResult {
	requestId: ID
	success: Boolean!
	resultCode: Int
}

type Subscription {
	prefsChanged: Boolean!
	peersChanged: Boolean!
	downloadsChanged: Boolean!
	imageModelsUpdated: ImageModelsUpdate!
	pairingRequested: PairingRequestNotice!
	pairingCompleted: PairingCompletedNotice!
	pairingStarted: PairingProgressNotice!
	pairingFailed: PairingProgressNotice!
	pairingCanceled: PairingProgressNotice!
	pomodoroSettingsChanged: Boolean!
	pomodoroAction: PomodoroAction!
	dlnaSenderChanged: DlnaSenderState!
	deviceNameUpdated: String!
	accessUpdated: Boolean!
	contentChanged: Boolean!
	clipboardChanged: ClipboardChange!
	screenMirrorState: MirrorState!
	screenMirrorVideoCodec: MirrorCodecConfiguration
	screenMirrorAudioGranted: Boolean!
	notificationCreated: Notification!
	notificationUpdated: Notification!
	notificationDeleted: Notification!
	notificationRefreshed: Boolean!
	messagesCreated: [ChatItem!]!
	messagesUpdated: [ChatItem!]!
	messagesDeleted: String!
	mediaUpdated: MediaChange!
	mediaScanProgress: ScanProgress!
	bookmarksUpdated: [Bookmark!]!
	feedsFetched: FeedSyncChange!
	uploadMergeResult: UploadMergeResult!
	fileSearchResults(root: String!, query: String!, offset: Int!, limit: Int!, sortBy: FileSortBy!): FileSearchResults!
	smsChanged: SmsProviderChange
	smsSendResult: SmsSendResult!
}

type Tag {
	id: ID!
	name: String!
	type: DataType!
	count: Int!
}

type UploadMergeResult {
	fileId: ID!
	ok: Boolean!
	value: String
	mergedSize: Long
	error: String
}

type Video implements MediaItem {
	width: Int!
	height: Int!
	rotation: Int!
	id: ID!
	title: String!
	path: String!
	durationMs: Long!
	size: Long!
	bucketId: ID!
	createdAt: Instant!
	updatedAt: Instant!
	takenAt: Instant
	isFavorite: Boolean!
	tags: [Tag!]!
}

"""
Directs the executor to include this field or fragment only when the `if` argument is true.
"""
directive @include(if: Boolean!) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT

"""
Directs the executor to skip this field or fragment when the `if` argument is true.
"""
directive @skip(if: Boolean!) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT

schema {
	query: Query
	mutation: Mutation
	subscription: Subscription
}
