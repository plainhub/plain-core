type PomodoroSettings {
	workDurationMin: Int!
	shortBreakDurationMin: Int!
	longBreakDurationMin: Int!
	pomodorosBeforeLongBreak: Int!
	showNotification: Boolean!
	playSoundOnComplete: Boolean!
	soundPath: String!
	originalSoundName: String!
}

enum PomodoroState {
	WORK
	SHORT_BREAK
	LONG_BREAK
}

type PomodoroToday {
	date: Instant!
	completedCount: Int!
	currentRound: Int!
	timeLeftSec: Int!
	totalTimeSec: Int!
	isRunning: Boolean!
	isPaused: Boolean!
	state: PomodoroState!
}

extend type Mutation {
	pausePomodoro: PomodoroToday!
	setPomodoroRemainingTime(remainingSec: Int!): PomodoroToday!
	startPomodoro(durationSec: Int!): PomodoroToday!
	stopPomodoro: PomodoroToday!
}

extend type Query {
	pomodoroSettings: PomodoroSettings!
	pomodoroToday: PomodoroToday!
}
