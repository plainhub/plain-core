cmake_minimum_required(VERSION 3.19)

set(library "$ENV{PLAIN_ONNX_RUNTIME_LIBRARY}")
set(target "$ENV{PLAIN_ONNX_RUNTIME_TARGET}")
string(TOLOWER "$ENV{PLAIN_ONNX_RUNTIME_SHA256}" expected_hash)
get_filename_component(runtime "${library}" DIRECTORY)

file(READ "${runtime}/runtime.json" receipt)
file(SHA256 "${library}" actual_hash)
file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/prepare_onnxruntime.py" actual_recipe)
string(JSON recorded_hash GET "${receipt}" sha256)
string(JSON recorded_target GET "${receipt}" identity target)
string(JSON recorded_source GET "${receipt}" identity source)
string(JSON recorded_recipe GET "${receipt}" identity recipe)

if(NOT recorded_source STREQUAL "ON" OR NOT recorded_target STREQUAL target OR NOT recorded_recipe STREQUAL actual_recipe)
    message(FATAL_ERROR "Prepared ONNX Runtime target or source recipe mismatch")
endif()
if(NOT actual_hash STREQUAL expected_hash OR NOT actual_hash STREQUAL recorded_hash)
    message(FATAL_ERROR "Prepared ONNX Runtime SHA-256 mismatch")
endif()
if(target MATCHES "apple-ios")
    file(SHA256 "${CMAKE_CURRENT_LIST_DIR}/apple_sdk_headers.cmake" actual_headers)
    string(JSON recorded_headers GET "${receipt}" identity apple_sdk_headers)
    if(NOT recorded_headers STREQUAL actual_headers)
        message(FATAL_ERROR "Prepared ONNX Runtime iOS SDK recipe mismatch")
    endif()
endif()
foreach(notice LICENSE ThirdPartyNotices.txt)
    if(NOT EXISTS "${runtime}/${notice}" OR IS_DIRECTORY "${runtime}/${notice}")
        message(FATAL_ERROR "Prepared ONNX Runtime is missing ${notice}")
    endif()
endforeach()
